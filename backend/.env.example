PORT=4000
NODE_ENV=development

# MySQL 8 — una de las dos formas:
# (a) URL completa (si la clave tiene símbolos como @ # / hay que codificarlos, ej. @ = %40)
DATABASE_URL=mysql://usuario:password@localhost:3306/sistemapos
# (b) campos sueltos (recomendado en cPanel; si DB_HOST está definido, se ignora DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cpanelusuario_sistemapos
# DB_PASSWORD=la-clave-tal-cual
# DB_NAME=cpanelusuario_sistemapos

JWT_ACCESS_SECRET=cambia-este-valor-en-produccion
JWT_REFRESH_SECRET=cambia-este-otro-valor-en-produccion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_HOURS=10
CORS_ORIGIN=http://localhost:5173

# Notificaciones push (usa las MISMAS claves que ya tenías en producción, o
# los celulares ya suscritos dejan de recibir avisos)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
